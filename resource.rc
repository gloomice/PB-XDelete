/* PB XDelete engine resources: icon + VERSIONINFO (V107) */
1 ICON "lflogo.ico"

1 VERSIONINFO
 FILEVERSION    1,0,7,0
 PRODUCTVERSION 1,0,7,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Wuhan Linkleading"
            VALUE "FileDescription",  "PB XDelete Turbo Delete Engine"
            VALUE "FileVersion",      "1.0.7.0"
            VALUE "InternalName",     "pb_xdelete"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 Wuhan Linkleading"
            VALUE "OriginalFilename", "pb_xdelete.exe"
            VALUE "ProductName",      "PB XDelete"
            VALUE "ProductVersion",   "1.0.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
